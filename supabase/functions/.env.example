# Copiar para supabase/functions/.env e preencher. NUNCA fazer commit do .env.
# Usado por: supabase functions serve --env-file supabase/functions/.env

# --- IA local (Ollama) ---
# As funções correm no Docker: host.docker.internal é o teu PC.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_NUM_CTX=8192
# Modo "pensar" (true torna o Resolver muito mais lento)
OLLAMA_THINK=false

# Alternativa só para comparar respostas: AI_PROVIDER=anthropic
# (reiniciar `npx supabase functions serve` depois de mudar)
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=sk-ant-...
# claude-opus-5-5 ou claude-fable-5-2
ANTHROPIC_MODEL=claude-opus-5-5

# --- Emails ---
# console = só escreve nos logs (local). Envio real: smtp (ex. Gmail) ou resend.
EMAIL_PROVIDER=console
# --- Gmail (sem contas novas): requer verificação em 2 passos + palavra-passe de aplicação ---
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=o-seu-email@gmail.com
# SMTP_PASS=abcdefghijklmnop
# EMAIL_FROM=MACASA IA <o-seu-email@gmail.com>
# --- Resend ---
# RESEND_API_KEY=re_...
# Antes de verificar o domínio no Resend, use o remetente de teste (só entrega ao email da sua conta Resend):
# EMAIL_FROM=MACASA IA <onboarding@resend.dev>
# Depois de verificar logicpathways.online no Resend:
# EMAIL_FROM=MACASA IA <noreply@logicpathways.online>
SITE_URL=http://localhost:8080

# Mostra o código OTP de 6 dígitos nos logs. SÓ em local.
DEV_LOG_OTP=true

# --- Stripe (modo de teste) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PREMIUM_PRICE_ID=price_...

# --- Sessões (uma sessão ativa por conta) ---
# Termina a sessão após X minutos sem atividade e após Y horas no total
SESSION_INACTIVITY_MIN=60
SESSION_MAX_HOURS=12
